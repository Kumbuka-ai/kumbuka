# In-container static file server for the built Starlight site.
# Listens on :80 only — the edge Caddy terminates TLS and reverse-proxies here.
:80 {
	root * /usr/share/caddy
	encode gzip zstd

	# Starlight emits directory-style routes (foo/index.html). file_server
	# resolves the trailing-slash directory index; serve a clean 404 otherwise.
	try_files {path} {path}/
	file_server

	handle_errors {
		@404 expression `{err.status_code} == 404`
		rewrite @404 /404.html
		file_server
	}

	header {
		# Static docs — long-cache the immutable hashed assets, revalidate HTML.
		?Cache-Control "public, max-age=300, must-revalidate"
	}
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
